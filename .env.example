# Copy to .env.local and fill in. Never commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.REGION.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=generate-with-openssl-rand-base64-32
BLOB_READ_WRITE_TOKEN=

# n8n workflows (see n8n/README.md)
N8N_WEBHOOK_BASE=https://yourname.app.n8n.cloud/webhook
N8N_WEBHOOK_SECRET=generate-with-openssl-rand-hex-24
