# Copy to .env.local and fill in. Never commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.REGION.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=generate-with-openssl-rand-base64-32
BLOB_READ_WRITE_TOKEN=

# n8n workflows (see n8n/README.md)
N8N_WEBHOOK_BASE=https://yourname.app.n8n.cloud/webhook
N8N_WEBHOOK_SECRET=generate-with-openssl-rand-hex-24

# Optional: override the n8n workflows' Gemini model and thinking level (minimal, low, medium, high, default)
AI_MODEL=
AI_THINKING_LEVEL=

# Sign in with WhatsApp (Meta WhatsApp Cloud API). Without these, sign-in falls back to email and password.
# In local development without them, codes are printed in the dev server's log instead.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved "Authentication" template with a copy-code button (defaults shown)
WHATSAPP_TEMPLATE=proofnest_login
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v23.0

# Shown on /privacy as the grievance contact. Use a role address, never a personal one.
GRIEVANCE_CONTACT=
